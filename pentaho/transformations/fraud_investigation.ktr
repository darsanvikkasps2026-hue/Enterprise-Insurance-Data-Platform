    <sql>SELECT
  transaction_id
, customer_id
, policy_number
, loss_date
, report_date
, insurance_type
, claim_amount
, claim_status
, incident_severity
, authority_contacted
, any_injury
, police_report_available
, incident_state
, incident_city
, incident_hour
, agent_id
, vendor_id
FROM "public".fraud_investigation
</sql>
